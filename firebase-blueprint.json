{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "hasConsented": {
          "type": "boolean",
          "description": "Whether the user has consented to the terms"
        },
        "consentedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the user consented"
        },
        "availableTime": {
          "type": "number",
          "description": "The available time in seconds for the user"
        }
      }
    },
    "PatientHistory": {
      "title": "PatientHistory",
      "description": "A session history for a patient",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user"
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date of the session"
        },
        "summary": {
          "type": "string",
          "description": "Clinical summary of the session"
        },
        "insights": {
          "type": "string",
          "description": "JSON stringified array of insights"
        },
        "tree_data": {
          "type": "string",
          "description": "JSON stringified tree data"
        },
        "clinical_data": {
          "type": "string",
          "description": "JSON stringified clinical data"
        },
        "therapeutic_plan": {
          "type": "string",
          "description": "JSON stringified therapeutic plan"
        },
        "transcript": {
          "type": "string",
          "description": "Raw session transcript"
        },
        "anonymized_transcript": {
          "type": "string",
          "description": "GDPR compliant anonymized transcript"
        }
      },
      "required": ["userId", "date", "summary", "insights", "tree_data", "clinical_data", "therapeutic_plan"]
    }
  },
  "firestore": {
    "patient_history/{historyId}": {
      "schema": "PatientHistory",
      "description": "History of patient sessions"
    }
  }
}
